# Copy to .env (local) or .env.production (hosted DB, for `npm run db:seed -- --env .env.production --force`)

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=HBMS
# "true" for hosted MySQL that requires TLS (TiDB Cloud, Aiven, PlanetScale)
DB_SSL=false
# session time zone for hosted DBs that run in UTC, e.g. +05:30 (leave empty locally)
DB_TIMEZONE=

# Either a full URL (rediss://default:pass@host:6379) or host/port for local Redis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=
SESSION_KEY=
SECRET_KEY=

GOOGLE_SITE_KEY=
GOOGLE_SECRET=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
imagekitUrl=

# optional: booking hold length in seconds (default 600)
HOLD_TTL_SECONDS=
